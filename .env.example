# Copy to .env and adjust. Never commit the real .env.
#
# On Railway: don't set these here. DATABASE_URL and PORT are injected
# automatically once a Postgres plugin is attached to the service; set
# ENVIRONMENT, DEBUG, and SECRET_KEY as Railway service Variables instead.

APP_NAME="Customer Database"
ENVIRONMENT=development
DEBUG=true

# SQLite by default. Later, for example:
#   postgresql+psycopg://user:pass@localhost:5432/customers   (Railway injects this form)
#   mssql+pyodbc://user:pass@host/customers?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./customers.db

# Log every SQL statement. Very noisy — debugging only.
SQL_ECHO=false

# REQUIRED in production — the app refuses to start with this placeholder when
# ENVIRONMENT=production. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

SESSION_COOKIE_NAME=cdws_session
SESSION_MAX_AGE=28800

PAGE_SIZE=25

# Optional: adds a "Sign in with Google" option to the login page. Leave both
# unset to keep password-only login. OAuth never creates accounts — the
# Google account's email must already match an existing user's (see
# `python manage.py createuser`); it just links that account for future logins.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID", type "Web application") and register these authorized
# redirect URIs:
#   http://127.0.0.1:8000/auth/google/callback           (local dev)
#   https://<your-app>.up.railway.app/auth/google/callback  (Railway)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bearer-token access to /api/* (used by the DocuSign extension app in
# docusign-extension/). A caller presents a Google access token; it is accepted
# only if it was issued to GOOGLE_CLIENT_ID above AND its verified email is on one
# of these comma-separated lists. Both empty = no Bearer access for anyone.
# Domains match exactly ("example.com" does not admit "sub.example.com").
API_ALLOWED_EMAIL_DOMAINS=
API_ALLOWED_EMAILS=
