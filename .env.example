# Copy to .env and adjust. Never commit the real .env.
#
# On Railway: don't set these here. DATABASE_URL and PORT are injected
# automatically once a Postgres plugin is attached to the service; set
# ENVIRONMENT, DEBUG, and SECRET_KEY as Railway service Variables instead.

APP_NAME="Customer Database"
ENVIRONMENT=development
DEBUG=true

# SQLite by default. Later, for example:
#   postgresql+psycopg://user:pass@localhost:5432/customers   (Railway injects this form)
#   mssql+pyodbc://user:pass@host/customers?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./customers.db

# Log every SQL statement. Very noisy — debugging only.
SQL_ECHO=false

# REQUIRED in production — the app refuses to start with this placeholder when
# ENVIRONMENT=production. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

SESSION_COOKIE_NAME=cdws_session
SESSION_MAX_AGE=28800

PAGE_SIZE=25
