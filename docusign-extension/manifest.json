{
  "name": "Customer Name Verification V2",
  "distribution": "PRIVATE",
  "description": {
    "short": "Verifies a signer's full name against the customer database.",
    "long": "Adds a Customer Full Name field to envelopes. When the signer fills it in, the name is checked against the customer database: an exact, case-insensitive match against an active customer passes."
  },
  "publicationRegions": ["US"],
  "termsOfServiceUrl": "https://web-production-9ea79.up.railway.app/terms-of-service",
  "privacyUrl": "https://web-production-9ea79.up.railway.app/privacy-policy",
  "supportUrl": "https://web-production-9ea79.up.railway.app/support",
  "publisher": {
    "name": "Magicparadigm Software",
    "email": "magicparadigm@live.com"
  },
  "connections": [
    {
      "name": "google",
      "description": "Sign in with Google so the app can call the customer database",
      "type": "oauth2",
      "params": {
        "provider": "CUSTOM",
        "clientId": "772414378538-uk62bgp11jngjo15le8kkns4rqorvq8r.apps.googleusercontent.com",
        "clientSecret": "",
        "scopes": ["openid", "email"],
        "grantType": "authorization_code",
        "customConfig": {
          "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "tokenUrl": "https://oauth2.googleapis.com/token",
          "authorizationMethod": "header",
          "scopeSeparator": " ",
          "requiredScopes": [],
          "authorizationParams": {
            "access_type": "offline",
            "prompt": "consent"
          }
        }
      }
    }
  ],
  "extensions": [
    {
      "name": "Customer Data",
      "description": "Lets DocuSign look up customer records and field definitions",
      "template": "DataIO.Version6.DataInputOutput",
      "actionReferences": ["get-type-names", "get-type-definitions", "search-records"],
      "capabilities": []
    },
    {
      "name": "Customer Name Verification",
      "description": "Verifies a full name against the customer database",
      "template": "ConnectedFields.Version1.ConnectedFields",
      "actionReferences": ["verify"],
      "capabilities": []
    }
  ],
  "actions": [
    {
      "name": "get-type-names",
      "description": "Lists the data types that can be verified",
      "template": "DataIO.Version6.GetTypeNames",
      "connectionsReference": "google",
      "params": { "uri": "https://web-production-9ea79.up.railway.app/api/connected-fields/type-names" }
    },
    {
      "name": "get-type-definitions",
      "description": "Returns the fields of each verifiable type",
      "template": "DataIO.Version6.GetTypeDefinitions",
      "connectionsReference": "google",
      "params": { "uri": "https://web-production-9ea79.up.railway.app/api/connected-fields/type-definitions" }
    },
    {
      "name": "search-records",
      "description": "Finds a customer whose full name matches exactly",
      "template": "DataIO.Version6.SearchRecords",
      "connectionsReference": "google",
      "params": { "uri": "https://web-production-9ea79.up.railway.app/api/connected-fields/search-records" }
    },
    {
      "name": "verify",
      "description": "Checks a full name against the customer database",
      "template": "ConnectedFields.Version1.Verify",
      "connectionsReference": "google",
      "params": { "uri": "https://web-production-9ea79.up.railway.app/api/connected-fields/verify" }
    }
  ]
}
